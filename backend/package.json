    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
